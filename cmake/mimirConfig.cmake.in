# mimirConfig.cmake — generated at build time from cmake/mimirConfig.cmake.in.
# Do not edit this file directly; edit the .in source instead.
#
# Recreates transient dependencies before loading mimirTargets.cmake so that
# consumers get a clear error message when a required package is missing,
# instead of a cryptic "target not found" from inside the targets file.

find_package(CUDAToolkit QUIET)
find_package(Vulkan QUIET)
find_package(PkgConfig QUIET)

# mimir was built with MIMIR_ENABLE_REMOTE=@MIMIR_BUILT_WITH_REMOTE@
if(@MIMIR_BUILT_WITH_REMOTE@)
    if(PkgConfig_FOUND AND NOT TARGET PkgConfig::FFMPEG)
        pkg_check_modules(FFMPEG IMPORTED_TARGET QUIET libavcodec libavutil libswscale)
    endif()
    if(NOT TARGET PkgConfig::FFMPEG)
        message(FATAL_ERROR
            "This mimir build has remote streaming enabled (MIMIR_ENABLE_REMOTE=ON), "
            "which requires ffmpeg (libavcodec, libavutil, libswscale).\n"
            "Install it and re-run cmake — e.g. on Arch: pacman -S ffmpeg")
    endif()
endif()

# mimir was built with MIMIR_ENABLE_QUIC=@MIMIR_BUILT_WITH_QUIC@
if(@MIMIR_BUILT_WITH_QUIC@)
    find_package(OpenSSL QUIET)
    if(PkgConfig_FOUND AND NOT TARGET PkgConfig::NGTCP2)
        pkg_check_modules(NGTCP2 IMPORTED_TARGET QUIET libngtcp2 libngtcp2_crypto_ossl)
    endif()
    if(NOT TARGET PkgConfig::NGTCP2)
        message(FATAL_ERROR
            "This mimir build has QUIC transport enabled (MIMIR_ENABLE_QUIC=ON), "
            "which requires ngtcp2 and OpenSSL (libngtcp2, libngtcp2_crypto_ossl).\n"
            "Install them and re-run cmake — e.g. on Arch: pacman -S libngtcp2 openssl")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mimirTargets.cmake")

# CPM-fetched packages define namespace aliases (e.g. spdlog::spdlog) in their own
# build, but those aliases are not preserved in exported imported targets.
# Recreate them here so consumers can use either form.
if(TARGET spdlog AND NOT TARGET spdlog::spdlog)
    add_library(spdlog::spdlog ALIAS spdlog)
endif()
if(TARGET glm AND NOT TARGET glm::glm)
    add_library(glm::glm ALIAS glm)
endif()
if(TARGET glm-header-only AND NOT TARGET glm::glm-header-only)
    add_library(glm::glm-header-only ALIAS glm-header-only)
endif()
